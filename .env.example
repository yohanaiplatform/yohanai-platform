NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Platform lock (fase under development / pemakaian personal).
# Semua route dibelokkan ke /under-development kecuali login, recovery
# password, OAuth callback, dan halaman legal. Registrasi ditutup total.
# Set ke 'false' (keduanya) untuk membuka platform kembali.
PLATFORM_LOCKED=true
NEXT_PUBLIC_PLATFORM_LOCKED=true

# Email yang boleh memakai platform selama terkunci, dipisah koma.
# Dikosongkan = semua akun yang sudah terdaftar boleh masuk.
PLATFORM_ALLOWED_EMAILS=

# Secret header untuk POST /api/leads/intake (dipanggil Apps Script, bukan
# browser). Generate string acak yang panjang, set nilai yang SAMA persis
# di sini, di Vercel, dan di CONFIG Apps Script (header x-intake-secret).
LEADS_INTAKE_SECRET=

# Signing secret webhook Kapso (POST /api/whatsapp/webhook). Ambil dari
# dashboard Kapso saat daftarkan webhook URL -- nilainya harus SAMA persis
# di sini dan di Vercel dengan yang tercatat di Kapso.
KAPSO_WEBHOOK_SECRET=

# Kirim pesan keluar (POST /api/whatsapp/send). KAPSO_API_KEY dari Kapso
# dashboard -> Integrations -> API keys. KAPSO_PHONE_NUMBER_ID dari halaman
# Phone Numbers (ID nomor/konfigurasi yang aktif -- sandbox atau produksi).
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=

# Cloudflare R2 (storage foto listing, pengganti Supabase Storage bucket
# `properties`). Ambil R2_ACCOUNT_ID dari URL dashboard Cloudflare
# (dash.cloudflare.com/<ACCOUNT_ID>/r2). R2_ACCESS_KEY_ID/SECRET dari
# R2 -> Manage R2 API Tokens -> Create API Token (izin Object Read & Write,
# scope ke bucket yohanai-property-photos saja). R2_PUBLIC_URL dari domain
# custom yang disambungkan ke bucket (mis. https://cdn.yohanai.id) --
# JANGAN pakai URL *.r2.dev untuk produksi (Cloudflare sendiri menandainya
# tidak untuk trafik produksi / bisa di-rate-limit).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=yohanai-property-photos
R2_PUBLIC_URL=

# Google Contacts (auto-create kontak saat lead baru masuk, akun
# yohan.ai.platform@gmail.com). Client ID/Secret dari Google Cloud Console
# -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Refresh token didapat sekali lewat GET /api/google-contacts/authorize
# (login sebagai admin) -> otorisasi -> token otomatis muncul di halaman
# callback, copy ke sini. Lihat docs/modules/crm.mdx bagian "Google Contacts"
# untuk panduan lengkap langkah demi langkah.
GOOGLE_CONTACTS_CLIENT_ID=
GOOGLE_CONTACTS_CLIENT_SECRET=
GOOGLE_CONTACTS_REFRESH_TOKEN=
GOOGLE_CONTACTS_REDIRECT_URI=

# Daily Report (GET /api/reports/daily, dipanggil GitHub Actions cron
# .github/workflows/daily-report.yml tiap jam 07:00 WIB). Secret di sini
# HARUS sama persis dengan secret DAILY_REPORT_SECRET di GitHub repo
# Settings -> Secrets and variables -> Actions.
DAILY_REPORT_SECRET=
# RESEND_API_KEY dari dashboard Resend (resend.com/api-keys) -- domain
# send.yohanai.id sudah terverifikasi di sana (dipakai juga oleh Supabase
# Auth SMTP), jadi RESEND_FROM_EMAIL bisa pakai alamat di domain itu, mis.
# reports@send.yohanai.id.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Personal per user (29 Sep 2026) -- setiap user terdaftar yang belum
# matikan toggle "Daily Report" di halaman Notification Preferences
# otomatis terima laporan ke email login masing-masing (admin/super_admin
# dapat agregat semua data, role lain di-scope ke assigned_to miliknya
# sendiri). DAILY_REPORT_RECIPIENT sudah TIDAK dipakai lagi.
#
# DAILY_REPORT_EMAIL_OVERRIDES: override tujuan untuk email login
# tertentu, format "email_login=email_tujuan" dipisah koma. Dipakai untuk
# admin@yohanai.id -> cvdevthan@gmail.com (Yohan pakai akun admin untuk
# develop/testing tapi jarang cek inbox admin@yohanai.id-nya).
DAILY_REPORT_EMAIL_OVERRIDES=admin@yohanai.id=cvdevthan@gmail.com

# Platform Report (laporan developer -- kesehatan infrastruktur & tier
# biaya, terpisah dari Daily Report bisnis di atas). Dikirim ke
# admin@yohanai.id secara default, tidak lewat preferensi user manapun.
# Kosongkan untuk pakai default admin@yohanai.id, isi untuk override.
PLATFORM_REPORT_RECIPIENT=
# Opsional -- kalau diisi, laporan ikut menampilkan status deployment
# Vercel terakhir. Buat di vercel.com/account/tokens (scope ke team
# Yohan.AI). VERCEL_PROJECT_ID dari Project Settings -> General.
# VERCEL_TEAM_ID cuma perlu kalau token-nya scoped ke team (bukan personal).
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
