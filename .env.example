NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Platform lock (fase under development / pemakaian personal).
# Semua route dibelokkan ke /under-development kecuali login, recovery
# password, OAuth callback, dan halaman legal. Registrasi ditutup total.
# Set ke 'false' (keduanya) untuk membuka platform kembali.
PLATFORM_LOCKED=true
NEXT_PUBLIC_PLATFORM_LOCKED=true

# Email yang boleh memakai platform selama terkunci, dipisah koma.
# Dikosongkan = semua akun yang sudah terdaftar boleh masuk.
PLATFORM_ALLOWED_EMAILS=

# Secret header untuk POST /api/leads/intake (dipanggil Apps Script, bukan
# browser). Generate string acak yang panjang, set nilai yang SAMA persis
# di sini, di Vercel, dan di CONFIG Apps Script (header x-intake-secret).
LEADS_INTAKE_SECRET=

# Signing secret webhook Kapso (POST /api/whatsapp/webhook). Ambil dari
# dashboard Kapso saat daftarkan webhook URL -- nilainya harus SAMA persis
# di sini dan di Vercel dengan yang tercatat di Kapso.
KAPSO_WEBHOOK_SECRET=

# Kirim pesan keluar (POST /api/whatsapp/send). KAPSO_API_KEY dari Kapso
# dashboard -> Integrations -> API keys. KAPSO_PHONE_NUMBER_ID dari halaman
# Phone Numbers (ID nomor/konfigurasi yang aktif -- sandbox atau produksi).
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
